<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="@dimen/screen_padding_bottom"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_institution"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/pill_padding_h"
            android:paddingVertical="@dimen/pill_padding_v"
            android:layout_marginBottom="@dimen/item_gap">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_institution"
                app:tint="@color/primary"
                android:contentDescription="Institution Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="Batangas State University • ARASOF"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            app:cardCornerRadius="@dimen/logo_corner_radius"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/primary_container"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="@dimen/logo_icon_size"
                    android:layout_height="@dimen/logo_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_explore"
                    app:tint="@color/on_primary"
                    android:contentDescription="Brand Emblem" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_institution"
            android:fontFamily="@font/inter_18pt_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="ArasPoint v2.4"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_caption"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="Create Account"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_title_large"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/section_gap"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Join ArasPoint with institutional credentials to track campus assets."
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_body"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="Full Name"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/input_padding_horizontal"
            android:layout_marginBottom="@dimen/item_gap">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_person_m3"
                app:tint="@color/on_surface_variant"
                android:contentDescription="Name Icon" />

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="e.g., Juan D. Dela Cruz"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="G-Suite Account"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/input_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_school_cap"
                app:tint="@color/on_surface_variant"
                android:contentDescription="Email Icon" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="21-01234@g.batstate-u.edu.ph"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/item_gap"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Requires active BatState-U G-Suite or SR-Code"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="Assigned College / Unit"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/input_padding_horizontal"
            android:layout_marginBottom="@dimen/item_gap"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_corporate_fare"
                app:tint="@color/on_surface_variant"
                android:contentDescription="College Icon" />

            <Spinner
                android:id="@+id/spinnerDepartment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="Create Password"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/input_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_lock_m3"
                app:tint="@color/on_surface_variant"
                android:contentDescription="Password Icon" />

            <EditText
                android:id="@+id/password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="••••••••••••"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="@dimen/input_icon_toggle_size"
                android:layout_height="@dimen/input_icon_toggle_size"
                android:src="@drawable/ic_visibility"
                app:tint="@color/on_surface_variant"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle Password" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/passwordStrengthProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="3"
            android:progress="0"
            android:progressTint="@color/primary" />

        <TextView
            android:id="@+id/passwordStrengthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/item_gap"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Minimum 8 characters with numbers &amp; symbols"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="Confirm Password"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/input_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_lock_m3"
                app:tint="@color/on_surface_variant"
                android:contentDescription="Confirm Password Icon" />

            <EditText
                android:id="@+id/confirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="••••••••••••"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/btnToggleConfirmPassword"
                android:layout_width="@dimen/input_icon_toggle_size"
                android:layout_height="@dimen/input_icon_toggle_size"
                android:src="@drawable/ic_visibility"
                app:tint="@color/on_surface_variant"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle Confirm Password" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/matchNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/item_gap"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_circle_m3"
                app:tint="@color/status_available"
                android:contentDescription="Match Check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="Passwords match"
                android:textColor="@color/status_available"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/checkboxTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="I agree to the University ICT Acceptable Use Policy &amp; Data Privacy Notice for this OOP Semestral Project."
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label"
            android:layout_marginBottom="@dimen/section_gap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/joinUs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/poppins_bold"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_title"
            app:cornerRadius="@dimen/btn_corner_radius"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/on_primary"
            app:elevation="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_regular"
                android:text="Already registered with ArasPoint? "
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/textLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_18pt_bold"
                android:padding="4dp"
                android:text="Sign In"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
