<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- System Banner Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/item_card_corner"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/surface_container_lowest"
        android:layout_marginBottom="12dp"/>

    <!-- KPI Section -->
    <TextView
        android:id="@+id/txtKpiSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Campus Asset Overview"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="@dimen/kpi_card_height"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="@dimen/item_card_corner"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/pill_padding_h">

                <TextView
                    android:id="@+id/txtStatTotalAssets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="--"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/kpi_number_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblStatTotalAssets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_18pt_regular"
                    android:text="Total Assets"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/kpi_label_text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="@dimen/kpi_card_height"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="@dimen/item_card_corner"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/pill_padding_h">

                <TextView
                    android:id="@+id/txtStatAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="--"
                    android:textColor="#2E7D32"
                    android:textSize="@dimen/kpi_number_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblStatAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_18pt_regular"
                    android:text="Available"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/kpi_label_text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="@dimen/kpi_card_height"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="@dimen/item_card_corner"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/pill_padding_h">

                <TextView
                    android:id="@+id/txtStatAttention"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="--"
                    android:textColor="#E65100"
                    android:textSize="@dimen/kpi_number_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblStatAttention"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_18pt_regular"
                    android:text="Attention"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/kpi_label_text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="@dimen/kpi_card_height"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="@dimen/item_card_corner"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/pill_padding_h">

                <TextView
                    android:id="@+id/txtStatReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="--"
                    android:textColor="#C62828"
                    android:textSize="@dimen/kpi_number_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblStatReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_18pt_regular"
                    android:text="Incident Reports"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/kpi_label_text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Campus Map Mini Map Card -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Campus Facilities Map"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMiniMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="@dimen/item_card_corner"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface_container_lowest"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/miniMapWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />

            <!-- Transparent touch interceptor overlay -->
            <View
                android:id="@+id/mapTouchOverlay"
                android:layout_width="match_parent"
                android:layout_height="379dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

            <!-- Semi-transparent overlay footer banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#F2FFFFFF"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_bold"
                        android:text="ARASOF Nasugbu Campus Map"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_explore"
                        app:tint="@color/primary"
                        android:contentDescription="Open Full Map" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_18pt_regular"
                    android:text="Tap to launch full interactive campus map &amp; navigation"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Quick Operations Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Quick Operations"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardQuickInventory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/quick_action_height"
        app:cardCornerRadius="@dimen/item_card_corner"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/surface_container_lowest"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/card_padding">

            <ImageView
                android:id="@+id/imgQuickOp1Icon"
                android:layout_width="@dimen/quick_action_icon_size"
                android:layout_height="@dimen/quick_action_icon_size"
                android:src="@drawable/ic_inventory_box"
                app:tint="@color/primary"
                android:contentDescription="Asset Inventory" />

            <TextView
                android:id="@+id/txtQuickOp1Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="Manage Asset Inventory"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/outline"
                android:contentDescription="Forward" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardQuickReport"
        android:layout_width="match_parent"
        android:layout_height="@dimen/quick_action_height"
        app:cardCornerRadius="@dimen/item_card_corner"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/surface_container_lowest"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/card_padding">

            <ImageView
                android:id="@+id/imgQuickOp2Icon"
                android:layout_width="@dimen/quick_action_icon_size"
                android:layout_height="@dimen/quick_action_icon_size"
                android:src="@drawable/ic_warning_shield"
                app:tint="#C62828"
                android:contentDescription="Maintenance Reports" />

            <TextView
                android:id="@+id/txtQuickOp2Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="View Incident &amp; Damage Reports"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/outline"
                android:contentDescription="Forward" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
