<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="@dimen/screen_padding_bottom"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_institution"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/pill_padding_h"
            android:paddingVertical="@dimen/pill_padding_v"
            android:layout_marginBottom="@dimen/item_gap">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_institution"
                app:tint="@color/primary"
                android:contentDescription="Institution Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_18pt_bold"
                android:text="Batangas State University • ARASOF"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            app:cardCornerRadius="@dimen/logo_corner_radius"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/primary_container"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="@dimen/logo_icon_size"
                    android:layout_height="@dimen/logo_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/map_pin"
                    app:tint="@color/on_primary"
                    android:contentDescription="ArasPoint Logo" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="ArasPoint"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="CAMPUS ASSET TRACKER"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_caption"
            android:letterSpacing="0.08"
            android:layout_marginBottom="@dimen/section_gap" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/welcome_back"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_title_large"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/section_gap"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Sign in to locate and manage campus assets."
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="University Email / SR-Code"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/input_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_school_cap"
                app:tint="@color/on_surface_variant"
                android:contentDescription="Email Icon" />

            <EditText
                android:id="@+id/email"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="name@g.batstate-u.edu.ph"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/btnClearEmail"
                android:layout_width="@dimen/input_icon_toggle_size"
                android:layout_height="@dimen/input_icon_toggle_size"
                android:src="@drawable/ic_cancel_circle"
                app:tint="@color/outline"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Clear text" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/item_gap"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Institutional G-Suite or student registration code"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="@string/password"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/input_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/input_icon_size"
                android:layout_height="@dimen/input_icon_size"
                android:src="@drawable/ic_lock_m3"
                app:tint="@color/on_surface_variant"
                android:contentDescription="Password Icon" />

            <EditText
                android:id="@+id/password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="@string/passhint"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="@dimen/text_body" />

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="@dimen/input_icon_toggle_size"
                android:layout_height="@dimen/input_icon_toggle_size"
                android:src="@drawable/ic_visibility"
                app:tint="@color/on_surface_variant"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle Password" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="@dimen/section_gap">

            <CheckBox
                android:id="@+id/checkboxRememberMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/inter_18pt_regular"
                android:text="Remember me"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/textClickable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_18pt_bold"
                android:padding="6dp"
                android:text="@string/forgot_password"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_label" />
        </RelativeLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/poppins_bold"
            android:text="Sign In"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_title"
            app:cornerRadius="@dimen/btn_corner_radius"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconTint="@color/on_primary"
            app:elevation="2dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:visibility="invisible"
            app:cardBackgroundColor="@color/surface_container"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_18pt_bold"
                        android:text="Quick sign-in demo roles:"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_badge_institution"
                        android:fontFamily="@font/inter_18pt_bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Demo"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_caption" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnDemoFaculty"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/quick_action_height"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_outlined"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Faculty"
                            android:src="@drawable/ic_person_m3"
                            app:tint="@color/on_surface_variant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/inter_18pt_bold"
                            android:text="Faculty"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDemoMaintenance"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/quick_action_height"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_outlined"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Maintenance"
                            android:src="@drawable/flag"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/inter_18pt_bold"
                            android:text="Maint."
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDemoAdmin"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/quick_action_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_outlined"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Admin"
                            android:src="@drawable/ic_institution"
                            app:tint="@color/secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/inter_18pt_bold"
                            android:text="Admin"
                            android:textColor="@color/secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:layout_marginBottom="@dimen/item_gap"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_regular"
                android:text="Don't have an account? "
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/textRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_18pt_bold"
                android:padding="4dp"
                android:text="Create an Account"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_institution"
                app:tint="@color/outline"
                android:contentDescription="Security Badge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter_18pt_regular"
                android:text="Authorized ARASOF accounts only • ICT Facilities"
                android:textColor="@color/outline"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
