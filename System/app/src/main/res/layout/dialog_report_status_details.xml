<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/surface_container_lowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_institution"
            android:fontFamily="@font/inter_18pt_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="MAINTENANCE TICKET DETAILS"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/detailReportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="Report Title"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailReportLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Location: HEB Floor 2 Room 204"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_body" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/surface_container_highest" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="Issue Description"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detailReportDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Description of issue..."
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardReportImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_container_low"
            android:visibility="gone">

            <ImageView
                android:id="@+id/detailReportImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Evidence Photo" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/detailReportStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_institution"
                android:fontFamily="@font/inter_18pt_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Status: PENDING"
                android:textColor="@color/status_maintenance"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detailReportPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_institution"
                android:fontFamily="@font/inter_18pt_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Priority: MEDIUM"
                android:textColor="@color/primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailReportAssignedTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="Assigned To: Unassigned"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/detailDateReported"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Reported on: 2026-10-12 14:00"
            android:textColor="@color/outline"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detailDateUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Last Updated: Pending"
            android:textColor="@color/outline"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseReportDetails"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/surface_container_high"
                android:fontFamily="@font/poppins_bold"
                android:text="Close"
                android:textAllCaps="false"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteReportTicket"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/error_container"
                android:fontFamily="@font/poppins_bold"
                android:text="Delete Ticket"
                android:textAllCaps="false"
                android:textColor="@color/error"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
