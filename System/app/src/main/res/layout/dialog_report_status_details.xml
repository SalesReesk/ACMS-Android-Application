<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/detailReportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Report Title"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detailReportLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/robotomono_regular"
        android:text="Location: HEB 204"
        android:textColor="#666666"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/detailReportDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/robotomono_regular"
        android:text="Description of issue..."
        android:textColor="#444444"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/detailReportStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter_18pt_bold"
        android:text="Status: PENDING"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/detailReportPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter_18pt_bold"
        android:text="Priority: MEDIUM"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/detailReportAssignedTo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/inter_18pt_bold"
        android:text="Assigned To: Unassigned"
        android:textColor="#8E24AA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/detailDateReported"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/robotomono_regular"
        android:text="Reported on: 2026-10-12 14:00"
        android:textColor="#666666"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/detailDateUpdated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/inter_18pt_bold"
        android:text="Last Updated by Admin: Pending"
        android:textColor="#8E24AA"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCloseReportDetails"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#8E24AA"
            android:fontFamily="@font/poppins_bold"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDeleteReportTicket"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#C62828"
            android:fontFamily="@font/poppins_bold"
            android:text="Delete Ticket"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
