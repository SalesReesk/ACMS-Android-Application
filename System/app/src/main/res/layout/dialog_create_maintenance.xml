<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Create Maintenance Account"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputMaintName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/inputs_color"
        android:fontFamily="@font/robotomono_regular"
        android:hint="Full Name"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputMaintEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/inputs_color"
        android:fontFamily="@font/robotomono_regular"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputMaintPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/inputs_color"
        android:fontFamily="@font/robotomono_regular"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnSubmitCreateMaint"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#8E24AA"
        android:fontFamily="@font/poppins_bold"
        android:text="Create Account"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>
