<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#7C3AED">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="48dp"
                android:paddingBottom="72dp"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Profile"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium" />

                    <ImageView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_white_alpha"
                        android:src="@drawable/ic_person_m3"
                        android:padding="8dp"
                        app:tint="#FFFFFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Edit Profile" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        <ImageView
                            android:id="@+id/profileImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/user_icon"
                            android:scaleType="centerCrop"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Profile Photo" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person_m3"
                            app:tint="#7C3AED"
                            android:contentDescription="Change photo" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-56dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/profileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_chip_purple_light"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/profileUid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UID: —"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="sans-serif"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_outline" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="Account Details"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface_container_lowest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_institution"
                        app:tint="@color/on_surface_variant" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Institution"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/profileCampus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BatStateU ARASOF-Nasugbu"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/surface_container_high"
                    android:layout_marginHorizontal="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_corporate_fare"
                        app:tint="@color/on_surface_variant" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Department / College"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/profileDepartment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/surface_container_high"
                    android:layout_marginHorizontal="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_school_cap"
                        app:tint="@color/on_surface_variant" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Student / Employee ID"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/profileIdNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/surface_container_high"
                    android:layout_marginHorizontal="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_warning_shield"
                        app:tint="@color/on_surface_variant" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Access Level"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_variant"
                            android:fontFamily="sans-serif" />
                        <TextView
                            android:id="@+id/profileAccessLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Read Only"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/labelAdminActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="Administration"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateMaintenanceAccount"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Create Maintenance Account"
            android:textAllCaps="false"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:visibility="gone"
            app:icon="@drawable/ic_person_m3"
            app:iconSize="18dp"
            app:iconTint="@color/on_surface_variant"
            app:strokeColor="@color/outline_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="ArasPoint v1.0.4 Testing\nSemestral Project for OOP"
            android:textSize="11sp"
            android:textColor="@color/outline"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginHorizontal="20dp" />

    </LinearLayout>
</ScrollView>
