# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Preserve model classes for Firebase Firestore & JSON deserialization
-keep class com.example.araspoint_map.backend.model.** { *; }

# Preserve WebView JavaScript Interface for map communication
-keepclassmembers class com.example.araspoint_map.frontend.activity.MapActivity$WebAppInterface {
    @android.webkit.JavascriptInterface <methods>;
}
